{
  "name": "agent-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop mascot proxy for CLI coding agents",
  "main": "dist/main/index.js",
  "bin": {
    "clia": "dist/cli/index.js"
  },
  "scripts": {
    "clia": "tsx src/cli/index.ts",
    "mock-agent": "tsx src/cli/mock-agent.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:phase2 && npm run test:phase3 && npm run test:phase5",
    "test:phase2": "tsx --test test/phase2-pty.test.ts",
    "test:phase3": "tsx --test test/phase3-main.test.ts",
    "test:phase5": "tsx --test test/phase5-hook.test.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:renderer": "vite --host 127.0.0.1",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "electron": "^38.2.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "strip-ansi": "^7.1.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
